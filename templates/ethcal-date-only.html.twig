{#
/**
 * @file
 * Template for displaying Ethiopian date only.
 *
 * Available variables:
 * - ethiopian_date: The formatted Ethiopian date.
 * - use_amharic: Boolean indicating if Amharic should be used.
 */
#}
<div class="ethcal-date-display ethcal-date-ethiopian-only{{ use_amharic ? ' ethcal-amharic' : '' }}">
  {{ ethiopian_date }}
</div>
