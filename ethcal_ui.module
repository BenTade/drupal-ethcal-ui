<?php

/**
 * @file
 * Ethiopian Calendar UI module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function ethcal_ui_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.ethcal_ui':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Ethiopian Calendar UI module provides a widget and formatters for date fields that support the Ethiopian calendar system. It extends the standard Drupal datetime field to allow content creators to input dates using an intuitive Ethiopian calendar interface and display them in various formats.') . '</p>';
      $output .= '<h3>' . t('Features') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Ethiopian calendar datepicker widget for date fields') . '</li>';
      $output .= '<li>' . t('Multiple display formatters (side-by-side, merged, Ethiopian-only)') . '</li>';
      $output .= '<li>' . t('Amharic language support for month names and numerals') . '</li>';
      $output .= '<li>' . t('Automatic conversion between Ethiopian and Gregorian calendars') . '</li>';
      $output .= '<li>' . t('Views integration for filtering and displaying dates') . '</li>';
      $output .= '</ul>';
      $output .= '<h3>' . t('Usage') . '</h3>';
      $output .= '<p>' . t('Add a standard Date field to any content type or entity. In the field widget settings, select "Ethiopian Date Picker" as the widget. Configure the widget to use Amharic text and choose display options. In the display settings, choose from the Ethiopian calendar formatters to control how dates appear in your content.') . '</p>';
      return $output;
  }
}

/**
 * Implements hook_theme().
 */
function ethcal_ui_theme($existing, $type, $theme, $path) {
  return [
    'ethcal_date_sidebyside' => [
      'variables' => [
        'gregorian_date' => NULL,
        'use_amharic' => FALSE,
        'date_format' => 'medium',
        'show_ethiopian_date' => TRUE,
        'show_gregorian_date' => TRUE,
        'ethiopian_date_format' => 'long',
        'gregorian_date_format' => 'medium',
      ],
      'template' => 'ethcal-date-sidebyside',
    ],
    'ethcal_date_merged' => [
      'variables' => [
        'gregorian_date' => NULL,
        'use_amharic' => FALSE,
        'ethiopian_date_format' => 'medium',
        'gregorian_date_format' => 'medium',
      ],
      'template' => 'ethcal-date-merged',
    ],
    'ethcal_date_only' => [
      'variables' => [
        'gregorian_date' => NULL,
        'use_amharic' => FALSE,
        'date_format' => 'long',
      ],
      'template' => 'ethcal-date-only',
    ],
  ];
}

/**
 * Prepares variables for ethcal_date_sidebyside template.
 */
function template_preprocess_ethcal_date_sidebyside(&$variables) {
  $gregorian_date = $variables['gregorian_date'];
  $use_amharic = $variables['use_amharic'];
  $show_ethiopian_date = $variables['show_ethiopian_date'] ?? TRUE;
  $show_gregorian_date = $variables['show_gregorian_date'] ?? TRUE;
  $ethiopian_date_format = $variables['ethiopian_date_format'] ?? 'long';
  $gregorian_date_format = $variables['gregorian_date_format'] ?? 'medium';

  if (!empty($gregorian_date)) {
    try {
      $date = new DateTime($gregorian_date);
      
      // Format Gregorian date
      if ($show_gregorian_date) {
        $variables['gregorian_formatted'] = _ethcal_ui_format_gregorian_date($date, $gregorian_date_format);
      }
      else {
        $variables['gregorian_formatted'] = '';
      }
      
      // Format Ethiopian date
      if ($show_ethiopian_date) {
        $variables['ethiopian_date'] = _ethcal_ui_convert_to_ethiopian($date, $use_amharic, $ethiopian_date_format);
      }
      else {
        $variables['ethiopian_date'] = '';
      }
    }
    catch (Exception $e) {
      $variables['gregorian_formatted'] = '';
      $variables['ethiopian_date'] = '';
    }
  }
}

/**
 * Prepares variables for ethcal_date_merged template.
 */
function template_preprocess_ethcal_date_merged(&$variables) {
  $gregorian_date = $variables['gregorian_date'];
  $use_amharic = $variables['use_amharic'];
  $ethiopian_date_format = $variables['ethiopian_date_format'] ?? 'medium';
  $gregorian_date_format = $variables['gregorian_date_format'] ?? 'medium';

  if (!empty($gregorian_date)) {
    try {
      $date = new DateTime($gregorian_date);
      $variables['gregorian_formatted'] = _ethcal_ui_format_gregorian_date($date, $gregorian_date_format);
      
      // Use the ethcal-ui package's EthiopianCalendar class
      $variables['ethiopian_date'] = _ethcal_ui_convert_to_ethiopian($date, $use_amharic, $ethiopian_date_format);
    }
    catch (Exception $e) {
      $variables['gregorian_formatted'] = '';
      $variables['ethiopian_date'] = '';
    }
  }
}

/**
 * Prepares variables for ethcal_date_only template.
 */
function template_preprocess_ethcal_date_only(&$variables) {
  $gregorian_date = $variables['gregorian_date'];
  $use_amharic = $variables['use_amharic'];
  $date_format = $variables['date_format'] ?? 'long';

  if (!empty($gregorian_date)) {
    try {
      $date = new DateTime($gregorian_date);
      $variables['ethiopian_date'] = _ethcal_ui_convert_to_ethiopian($date, $use_amharic, $date_format);
    }
    catch (Exception $e) {
      $variables['ethiopian_date'] = '';
    }
  }
}

/**
 * Helper function to convert Gregorian date to Ethiopian date.
 *
 * Uses the ethcal-ui package's EthiopianCalendar class.
 */
function _ethcal_ui_convert_to_ethiopian($date, $use_amharic = FALSE, $format = 'medium') {
  // Ensure Composer autoload is available
  $autoload_file = DRUPAL_ROOT . '/vendor/autoload.php';
  if (!file_exists($autoload_file)) {
    // Fallback: try module's vendor directory
    $autoload_file = __DIR__ . '/vendor/autoload.php';
  }
  
  if (!file_exists($autoload_file)) {
    \Drupal::logger('ethcal_ui')->error('Composer autoload file not found. Please run composer install.');
    return '';
  }
  
  require_once $autoload_file;
  
  // Check if the EthiopianCalendar class is available
  $eth_calendar_file = __DIR__ . '/lib/php/EthiopianCalendar.php';
  if (!file_exists($eth_calendar_file)) {
    \Drupal::logger('ethcal_ui')->error('EthiopianCalendar class not found. Module files may be corrupted.');
    return '';
  }
  
  require_once $eth_calendar_file;
  
  try {
    $calendar = new EthiopianCalendar();
    $ethDate = $calendar->toEthiopian($date);
    
    // Get month name
    $month_name = _ethcal_ui_get_month_name($ethDate['month'], $use_amharic);
    
    // Format the date based on format preference
    switch ($format) {
      case 'short':
        // e.g., "1/1/2015" or "፩/፩/፪፻፲፭"
        if ($use_amharic) {
          return _ethcal_ui_to_amharic_number($ethDate['day']) . '/' . 
                 _ethcal_ui_to_amharic_number($ethDate['month']) . '/' . 
                 _ethcal_ui_to_amharic_number($ethDate['year']);
        }
        else {
          return $ethDate['day'] . '/' . $ethDate['month'] . '/' . $ethDate['year'];
        }
        
      case 'medium':
        // e.g., "1 Meskerem 2015" or "፩ መስከረም ፪፻፲፭"
        if ($use_amharic) {
          return _ethcal_ui_to_amharic_number($ethDate['day']) . ' ' . 
                 $month_name . ' ' . 
                 _ethcal_ui_to_amharic_number($ethDate['year']);
        }
        else {
          return $ethDate['day'] . ' ' . $month_name . ' ' . $ethDate['year'];
        }
        
      case 'long':
      default:
        // e.g., "Meskerem 1, 2015" or "መስከረም ፩, ፪፻፲፭"
        if ($use_amharic) {
          return $month_name . ' ' . 
                 _ethcal_ui_to_amharic_number($ethDate['day']) . ', ' . 
                 _ethcal_ui_to_amharic_number($ethDate['year']);
        }
        else {
          return $month_name . ' ' . $ethDate['day'] . ', ' . $ethDate['year'];
        }
    }
  }
  catch (Exception $e) {
    \Drupal::logger('ethcal_ui')->error('Error converting date: @error', ['@error' => $e->getMessage()]);
    return '';
  }
}

/**
 * Helper function to format Gregorian date.
 */
function _ethcal_ui_format_gregorian_date($date, $format = 'medium') {
  switch ($format) {
    case 'short':
      // e.g., "9/11/2022"
      return $date->format('n/j/Y');
      
    case 'medium':
      // e.g., "Sep 11, 2022"
      return $date->format('M j, Y');
      
    case 'long':
    default:
      // e.g., "September 11, 2022"
      return $date->format('F j, Y');
  }
}

/**
 * Get month name (Ethiopian or Amharic).
 */
function _ethcal_ui_get_month_name($month, $use_amharic = FALSE) {
  $months_english = [
    'Meskerem', 'Tikimt', 'Hidar', 'Tahsas', 'Tir', 'Yekatit',
    'Megabit', 'Miazia', 'Ginbot', 'Sene', 'Hamle', 'Nehase', 'Pagume'
  ];
  $months_amharic = [
    'መስከረም', 'ጥቅምት', 'ኅዳር', 'ታኅሳስ', 'ጥር', 'የካቲት',
    'መጋቢት', 'ሚያዝያ', 'ግንቦት', 'ሰኔ', 'ሐምሌ', 'ነሐሴ', 'ጳጉሜን'
  ];
  
  $month_names = $use_amharic ? $months_amharic : $months_english;
  return $month_names[$month - 1] ?? '';
}

/**
 * Convert number to Amharic numerals.
 */
function _ethcal_ui_to_amharic_number($num) {
  $amharic_numerals = ['፲', '፩', '፪', '፫', '፬', '፭', '፮', '፯', '፰', '፱'];
  $result = '';
  foreach (str_split((string) $num) as $digit) {
    $result .= $amharic_numerals[(int) $digit];
  }
  return $result;
}
